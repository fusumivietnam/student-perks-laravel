APP_NAME="Student Perks Hub"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_HTTP_PORT=127.0.0.1:8080
# Laravel key: base64-encoded 32 random bytes. Keep private.
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=student_perks
DB_USERNAME=student_perks
DB_PASSWORD=
LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
