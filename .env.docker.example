APP_NAME="Student Perks Hub"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_HTTP_PORT=8080
# Generate once via: docker run --rm dunglas/frankenphp:1-php8.3 php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=student_perks
DB_USERNAME=student_perks
DB_PASSWORD=
LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
