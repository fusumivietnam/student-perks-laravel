# Production runtime template. COPY to .env on the VPS; never commit .env.
APP_NAME="Student Perks Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_HTTP_PORT=127.0.0.1:8080
# Comma-separated verified HTTPS reverse-proxy IPs/CIDRs only; never *.
TRUSTED_PROXIES=
# Set exact approved public hostnames, without scheme/port; e.g. example.com,www.example.com.
# Requests with other Host values will be rejected; no wildcard subdomains.
TRUSTED_HOSTS=example.com
# Generate securely: printf 'base64:%s\n' "$(openssl rand -base64 32)"
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=student_perks
DB_USERNAME=student_perks
# Use a unique random password and keep it outside Git.
DB_PASSWORD=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=file
# Require HTTPS for admin/session cookies on the real production domain.
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log
